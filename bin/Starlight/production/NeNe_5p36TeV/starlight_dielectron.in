PROD_MODE = 1                # gg or gP switch (1 = 2-photon, 2 = coherent vector meson (narrow), 3 = coherent vector meson (wide), 4 = incoherent vector meson)
PROD_PID = 11                # Channel of interest
BEAM_1_Z = 10                # Z of projectile
BEAM_1_A = 20               # A of projectile
BEAM_2_Z = 10                # Z of target
BEAM_2_A = 20               # A of target
COLL_E = 5362                # Collision energy in GeV
BEAM_1_WS_A = 0.698           # Woods-Saxon skin depth of projectile
BEAM_1_WS_R = 2.791           # Woods-Saxon nuclear radius of projectile
BEAM_2_WS_A = 0.698           # Woods-Saxon skin depth of target
BEAM_2_WS_R = 2.791           # Woods-Saxon nuclear radius of target
W_MIN = -1
W_MAX = -1
W_N_BINS = 50
RAP_MAX = 2.5    #max y
RAP_N_BINS = 50  #Bins in y
CUT_PT = 0       #Cut in pT? 0 = no
PT_MIN = 1       #Minimum pT in GeV
PT_MAX = 3.0     #Maximum pT in GeV
CUT_ETA = 0      #Cut in pseudorapidity? 0 = no
ETA_MIN = -10
ETA_MAX = 10
BREAKUP_MODE = 5             # Controls the nuclear breakup; a 5 here makes no requirement on the breakup of the ions
INTERFERENCE = 0             # Interference (0 = off, 1 = on)
IF_STRENGTH = 1.             # % of intefernce (0.0 - 0.1)
INT_PT_MAX = 0.24            # Maximum pt considered, when interference is turned on
INT_PT_N_BINS = 120          # Number of pt bins when interference is turned on
INT_PT_WIDTH = 0             # Used only when the interference option above is turned on. Specifies the width of pT bins
XSEC_METHOD = 1              # Set to 0 to use old method for calculating gamma-gamma luminosity
BSLOPE_DEFINITION = 0        # Used for incoherent nuclear collisions to set the t-spectrum
BSLOPE_VALUE = 0             # When BSLOPE_DEFINITION=1, determines the exponential slope of t-spectrum
